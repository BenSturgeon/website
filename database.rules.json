{
  "rules": {
    ".read": false,
    ".write": false,

    "pageRefs": {
      ".read": true,
      ".write": false
    },

    "pages": {
      ".read": true,
      ".write": false
    },

    "rate": {
      "$uid": {
        ".read": false,
        ".write": "auth != null && auth.uid === $uid && (!data.exists() || now - data.val() > 60000)",
        ".validate": "newData.isNumber() && newData.val() <= now + 5000 && newData.val() >= now - 5000"
      }
    },

    "pending": {
      ".read": false,
      "$page": {
        "$comment": {
          ".write": "auth != null && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['name', 'comment', 'dateTime', 'uid']) && newData.child('uid').val() === auth.uid && root.child('rate').child(auth.uid).val() >= now - 15000",
          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
          "comment": { ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 1200" },
          "dateTime": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "uid": { ".validate": "newData.isString() && newData.val().length <= 128" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
